# CyberArk Vault.
# The safe name matches the VM name. Azure sets the VM hostname to the VM name
# ({labid}-{noun}-{verb}-{4char}), which is kept within the 28-char safe cap, so
# the running host's name IS the safe name. Precedence: an exported SAFE_NAME
# wins; else VM_NAME; else the host's short name. A long custom instance name
# could exceed 28 and would need an explicit SAFE_NAME.
SAFE_NAME="${SAFE_NAME:-${VM_NAME:-$(hostname -s 2>/dev/null || hostname)}}"

# CyberArk authn-azure service. Setup creates/configures this service when needed.
AUTHN_AZURE_SERVICE_ID="azure-1"

# CyberArk platform for the demo Postgres credential. Deployment validates a
# matching active platform exists on the tenant (idira); the student uses it when
# vaulting and SRS uses it to rotate.
POSTGRES_PLATFORM_ID="${POSTGRES_PLATFORM_ID:-PostgreSQL}"

# Azure metadata for the Ubuntu VM running this demo.
# Leave these blank to let setup discover them from Azure IMDS where possible.
AZURE_TENANT_ID=""
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP=""

# This can be discovered when the managed identity token contains the user-assigned
# identity resource ID. If discovery fails, set it to the identity name attached
# to this VM.
AZURE_USER_ASSIGNED_IDENTITY_NAME=""

# Optional but required when the VM has multiple managed identities attached.
AZURE_CLIENT_ID=""

# Token audience requested from Azure IMDS for authn-azure.
AZURE_IMDS_RESOURCE="${AZURE_IMDS_RESOURCE:-https://management.azure.com/}"

# Optional Conjur host leaf name. Defaults to AZURE_USER_ASSIGNED_IDENTITY_NAME.
AZURE_WORKLOAD_HOST_NAME=""

# Optional fallback. When true, demo.sh fetches a short-lived Azure IMDS token and
# passes it to summon-conjur with CONJUR_AUTHN_JWT_TOKEN.
SUMMON_AZURE_FETCH_TOKEN="false"
