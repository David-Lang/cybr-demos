# Activity workspace generation inputs.
# setup_activity.sh sources this file before validating required values.

# Required SQL connection values.
SQL_SERVER="${SQL_SERVER:-}"
SQL_DATABASE="${SQL_DATABASE:-}"

# Required unless SQL_PASSWORD_N is set for every student.
SQL_PASSWORD_TEMPLATE="${SQL_PASSWORD_TEMPLATE:-}"

# Student workspace settings.
STUDENT_COUNT="${STUDENT_COUNT:-30}"
LABS_ROOT="${LABS_ROOT:-/opt/labs}"
ACTIVITY_DIR_NAME="${ACTIVITY_DIR_NAME:-hardcoded-secret-remediation}"
STUDENT_PREFIX="${STUDENT_PREFIX:-student}"

# Query rendered into the generated scripts.
SQL_QUERY="${SQL_QUERY:-SELECT TOP 5 * FROM dbo.ExampleTable}"

# Credential template.
# Supported template tokens: __STUDENT__, __N__, __NN__.
SQL_USERNAME_TEMPLATE="${SQL_USERNAME_TEMPLATE:-__STUDENT___user}"

# Parent demo setup output. Leave blank to use ../conjur_authn_azure.env.
CONJUR_AUTHN_AZURE_ENV="${CONJUR_AUTHN_AZURE_ENV:-}"

# Optional per-student overrides. Add more numbered entries as needed.
# SQL_SERVER_1=""
# SQL_DATABASE_1=""
# SQL_USERNAME_1="student1_user"
# SQL_PASSWORD_1=""
