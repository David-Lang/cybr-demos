# Activity workspace generation inputs (Postgres, VM-local).
# setup_activity.sh sources this file before rendering the per-student workspace.
# Defaults must match activity/db_setup.sh.

# Local Postgres the workspace scripts connect to (stood up by db_setup.sh).
DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-5432}"
DB_NAME="${DB_NAME:-trainingdb}"

# Initial credential the hardcoded script exposes and the student later vaults.
DB_USERNAME="${DB_USERNAME:-appuser}"
DB_PASSWORD="${DB_PASSWORD:-InitialSecret1!}"

# Postgres query rendered into the scripts.
SQL_QUERY="${SQL_QUERY:-SELECT * FROM example_table ORDER BY id LIMIT 5;}"

# CyberArk vaulting targets, baked into secrets.yml so the student does not edit
# it. SAFE_NAME defaults to the VM name (the safe the student creates);
# ACCOUNT_NAME is the account the student onboards. The guide tells the student
# to use these exact names so the pre-rendered secrets.yml resolves.
SAFE_NAME="${SAFE_NAME:-$(hostname -s 2>/dev/null || hostname)}"
ACCOUNT_NAME="${ACCOUNT_NAME:-postgres-appuser}"

# Address stored on the vaulted account. Used only by SRS (through the Idira
# System connector) to reach this VM's Postgres for rotation — NOT by the local
# scripts, which connect to DB_HOST (localhost). Must be connector-reachable;
# defaults to the VM's FQDN/hostname. Set to the VM private IP if the connector
# routes by IP.
ROTATION_ADDRESS="${ROTATION_ADDRESS:-$(hostname -f 2>/dev/null || hostname)}"

# Student workspace settings. One VM per student -> STUDENT_COUNT=1 by default.
STUDENT_COUNT="${STUDENT_COUNT:-1}"
LABS_ROOT="${LABS_ROOT:-/opt/labs}"
ACTIVITY_DIR_NAME="${ACTIVITY_DIR_NAME:-hardcoded-secret-remediation}"
STUDENT_PREFIX="${STUDENT_PREFIX:-student}"

# Parent demo setup output. Leave blank to use ../conjur_authn_azure.env.
CONJUR_AUTHN_AZURE_ENV="${CONJUR_AUTHN_AZURE_ENV:-}"
