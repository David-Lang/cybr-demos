# Summon maps these environment variable names to CyberArk safe-backed variables.
# psql reads PGUSER/PGPASSWORD natively, so no wrapper is needed. The paths point
# at the account the student vaults: safe = the VM name, account = ACCOUNT_NAME.
# This file is pre-rendered — do not edit it; instead vault the account using the
# exact safe and account names shown in the guide so these paths resolve.
PGUSER: !var data/vault/__SAFE_NAME__/__ACCOUNT_NAME__/username
PGPASSWORD: !var data/vault/__SAFE_NAME__/__ACCOUNT_NAME__/password
