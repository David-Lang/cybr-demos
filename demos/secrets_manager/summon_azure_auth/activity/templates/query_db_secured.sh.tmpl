#!/bin/bash
set -euo pipefail

: "${SQL_SERVER:?SQL_SERVER is required}"
: "${SQL_DATABASE:?SQL_DATABASE is required}"
: "${DB_USERNAME:?DB_USERNAME is required}"
: "${DB_PASSWORD:?DB_PASSWORD is required}"

sqlcmd \
  -S "$SQL_SERVER" \
  -d "$SQL_DATABASE" \
  -U "$DB_USERNAME" \
  -P "$DB_PASSWORD" \
  -C \
  -Q __SQL_QUERY_Q__
