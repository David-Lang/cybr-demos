#!/bin/bash
set -euo pipefail

: "${SQL_SERVER:?SQL_SERVER is required}"
: "${SQL_DATABASE:?SQL_DATABASE is required}"
: "${SQL_USERNAME:?SQL_USERNAME is required}"
: "${SQL_PASSWORD:?SQL_PASSWORD is required}"

sqlcmd \
  -S "$SQL_SERVER" \
  -d "$SQL_DATABASE" \
  -U "$SQL_USERNAME" \
  -P "$SQL_PASSWORD" \
  -C -y 22 -Y 22 \
  -Q __SQL_QUERY_Q__
