FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/giftapp ./cmd/giftapp

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/giftapp /usr/local/bin/giftapp
ENV GIFTAPP_MODE=hardcoded
USER 1000:1000
ENTRYPOINT ["giftapp"]
