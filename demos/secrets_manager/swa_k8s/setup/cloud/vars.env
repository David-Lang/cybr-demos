# ─── Cloud provider inputs for the multi-cloud SPIFFE demo ──────────────────
# Edit the values below, then run:
#   bash setup.sh --aws          # AWS only
#   bash setup.sh --azure        # Azure only
#   bash setup.sh --gcp          # GCP only
#   bash setup.sh --aws --azure --gcp   # all three
#
# Cloud credentials should be placed in separate *_credentials.env files:
#   - aws_credentials.env
#   - azure_credentials.env
#   - gcp_credentials.env

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_ACCOUNT_ID=""          # 12-digit account number
AWS_REGION="${AWS_REGION:-us-east-1}"

# ─── Azure ───────────────────────────────────────────────────────────────────
AZURE_TENANT_ID=""         # Entra ID tenant GUID
AZURE_SUBSCRIPTION_ID=""
AZURE_REGION="${AZURE_REGION:-eastus}"

# ─── GCP ─────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=""          # GCP project ID (string name, not number)
GCP_REGION="${GCP_REGION:-us-east1}"
