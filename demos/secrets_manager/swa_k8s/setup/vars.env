# ─── Resource naming ────────────────────────────────────────────────────────
USECASE_ID="$LAB_ID-swa-k8s"
SAFE_NAME="$USECASE_ID"

# ─── Conjur JWT authenticator ───────────────────────────────────────────────
SM_SERVICE_NAME="$USECASE_ID"

# JWT claim used to map the SWA server service account to its host identity
JWT_CLAIM_IDENTITY="sub"
JWT_SWA_SERVER_SUBJECT="system:serviceaccount:swa-system:swa-server"
JWT_CLAIM_IDENTITY_VALUE="$JWT_SWA_SERVER_SUBJECT"

# ─── Secret paths (PAM safe → Conjur sync) ──────────────────────────────────
SM_API_KEY_ID="data/vault/$SAFE_NAME/giftapp-api-key/password"
SM_DB_PASS_ID="data/vault/$SAFE_NAME/giftapp-db-pass/password"

# ─── SWA release / images ───────────────────────────────────────────────────
SWA_CONTAINER_IMAGES_S3="${SWA_CONTAINER_IMAGES_S3:-s3://mis-cybr-demos/pm/swa-container-images}"
SWA_TF_PROVIDER_S3="${SWA_TF_PROVIDER_S3:-s3://mis-cybr-demos/pm/terraform-provider}"
SWA_IMAGE_VERSION="${SWA_IMAGE_VERSION:-0.0.0-SNAPSHOT}"

# ─── SWA trust domain / K8s agent ───────────────────────────────────────────
SWA_TRUST_DOMAIN_NAME="${SWA_TRUST_DOMAIN_NAME:-$USECASE_ID.k8s-workloads.io}"
SWA_TRUST_DOMAIN="$SWA_TRUST_DOMAIN_NAME"
SWA_RESOURCE_PREFIX="${SWA_RESOURCE_PREFIX:-$USECASE_ID}"
SWA_NODE_GROUP_NAME="${SWA_NODE_GROUP_NAME:-$USECASE_ID-node-group}"
SWA_CLUSTER_NAME="${SWA_CLUSTER_NAME:-$USECASE_ID-cluster}"
SWA_SOCKET_PATH="${SWA_SOCKET_PATH:-/tmp/swa-agent/public/api.sock}"
SWA_SOCKET_HOST_PATH="${SWA_SOCKET_HOST_PATH:-/tmp/swa-agent}"
SWA_NAMESPACE="${SWA_NAMESPACE:-swa-system}"

# The unix workload attestor maps the pod's process UID into the SPIFFE ID.
GIFTAPP_SWA_UID="${GIFTAPP_SWA_UID:-1000}"
SWA_WORKLOAD_SPIFFE_ID="${SWA_WORKLOAD_SPIFFE_ID:-spiffe://$SWA_TRUST_DOMAIN_NAME/$SWA_NODE_GROUP_NAME/workload/$GIFTAPP_SWA_UID}"

# ─── GiftApp images ──────────────────────────────────────────────────────────
# REQUIRED: registry/repo prefix for giftapp-hardcoded and giftapp-swa images.
# Use a local RKE2-visible image name if images are imported directly on EC2.
GIFTAPP_REGISTRY="${GIFTAPP_REGISTRY:-}"
GIFTAPP_IMAGE_TAG="${GIFTAPP_IMAGE_TAG:-latest}"

# ─── GiftApp demo credentials (intentionally plaintext for attack demo) ──────
GIFTAPP_API_KEY="${GIFTAPP_API_KEY:-APPSECRETxfindme}"
DB_USER="${DB_USER:-giftapp-db01}"
DB_PASS="${DB_PASS:-Cyberark1}"

# ─── Kubernetes namespaces ───────────────────────────────────────────────────
NAMESPACE_HARDCODED="$LAB_ID-giftapp-hardcoded"
NAMESPACE_SWA="$LAB_ID-giftapp-swa"

# ─── K8s cluster type and OIDC keys (populated by init_k8s.sh) ──────────────
K8S_TYPE="rancher"
K8S_PUBLIC_KEYS="{{ .K8S_PUBLIC_KEYS }}"
K8S_JWKS_URI="{{ .K8S_JWKS_URI }}"
