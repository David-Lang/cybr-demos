#//------------------------------------------------------------------------------------------------
# Copy to setup/vars.env and customize (setup/vars.env is gitignored).
# CyberArk API creds: demos/tenant_vars.local.sh (not tenant_vars.sh placeholders).
#//------------------------------------------------------------------------------------------------

# Privilege Cloud safe — use k8s-eso to share the k8s/eso demo safe, or poc-jenkins-${LAB_ID} for dedicated
SAFE_NAME="k8s-eso"

# aws   = EC2 public DNS  (recommended for shared lab demos)
# local = Docker only     (laptop demo; default public-keys mode means no tunnel needed)
DEPLOY_PROFILE="aws"

JENKINS_PORT=8081
JENKINS_CONTAINER="cybr-jenkins"

# Must match jenkins_full_name JWT claim (root pipeline → GlobalCredentials)
JWT_CLAIM_IDENTITY="GlobalCredentials"

CONJUR_JWT_AUTHN_ID="jenkins1"
CONJUR_AUDIENCE="cyberark-conjur"

#//------------------------------------------------------------------------------------------------
# JWT trust + auth target
#//------------------------------------------------------------------------------------------------
# JWT_TRUST_MODE — how Conjur validates Jenkins JWT signatures.
#   public-keys = (default) finish_setup.sh mirrors the live Jenkins JWKS
#                 into the Conjur 'public-keys' variable. Conjur verifies
#                 signatures locally. Works on a laptop with no inbound network.
#   jwks-uri    = Conjur fetches JWKS over HTTP from JWKS_URL_OVERRIDE
#                 (or JENKINS_JWKS_URI). Required if Conjur lives behind an
#                 Edge node that can reach Jenkins on a Docker / private network.
JWT_TRUST_MODE="public-keys"

# CONJUR_AUTH_TARGET — where the Jenkins plugin sends authn-jwt requests.
#   cloud = (default) Conjur Cloud SaaS at $TENANT_SUBDOMAIN.secretsmgr.cyberark.cloud
#   edge  = Conjur Cloud Edge container running on this Docker host
CONJUR_AUTH_TARGET="cloud"

# JWKS_URL_OVERRIDE — only used when JWT_TRUST_MODE=jwks-uri.
# If empty, finish_setup.sh falls back to JENKINS_JWKS_URI (in setup/.jenkins.env).
# For Edge mode on Docker Desktop, set to the URL the Edge container can reach
# Jenkins on, typically:
#   http://host.docker.internal:${JENKINS_PORT}/jwtauth/conjur-jwk-set
JWKS_URL_OVERRIDE=""

#//------------------------------------------------------------------------------------------------
# Conjur Cloud Edge (only used when CONJUR_AUTH_TARGET=edge)
#//------------------------------------------------------------------------------------------------
EDGE_CONTAINER="cybr_conjur_edge"   # Match this to the 'Edge container name' in SaaS UI.
                                    # SaaS UI only allows A-Z, a-z, 0-9, underscore.
EDGE_HOST="host.docker.internal"   # Docker Desktop magic hostname for the host
EDGE_PORT="443"                    # bound to container 8443
EDGE_HEALTH_PORT="444"             # bound to container 8444 (HTTP /health)

# Persistence dir for Edge config + audit. Auto-detected if empty:
#   macOS: $HOME/cyberark    (root of / is read-only on macOS)
#   Linux: /cyberark
EDGE_DATA_DIR=""

# Path to the install script you copied from the Secrets Manager UI Edges page.
# That script contains a one-shot install token (8-min expiry) and the
# `docker run` command. It's gitignored. Default lives at:
#   setup/edge/install.sh
# Set this only if you saved it elsewhere.
EDGE_INSTALL_SCRIPT=""

#//------------------------------------------------------------------------------------------------
# Optional: stable cloudflared tunnel for the local profile.
# Only needed if JWT_TRUST_MODE=jwks-uri AND CONJUR_AUTH_TARGET=cloud (i.e. you
# need Conjur Cloud SaaS to reach Jenkins over the internet). Not needed for
# public-keys mode or Edge mode.
#//------------------------------------------------------------------------------------------------
# CLOUDFLARED_TUNNEL_NAME=""
# CLOUDFLARED_TUNNEL_HOSTNAME="jenkins-demo.example.com"

# Generated by setup/jenkins/setup.sh — do not set manually
# JENKINS_LOCAL_URL=""
# JENKINS_PUBLIC_URL=""
# JENKINS_ISSUER=""
# JENKINS_JWKS_URI=""
