#!/bin/bash
# setup/edge/install.sh.example — paste the SaaS-generated install command here.
#
# This file is a placeholder. To bring up Conjur Cloud Edge:
#
#   1. Sign into Secrets Manager UI -> Edges -> Install new Edge
#   2. Set:
#        Container platform     : Docker
#        Edge name              : (anything; this is the SaaS-side label)
#        Edge container name    : cybr_conjur_edge   (UNDERSCORES — SaaS UI rejects hyphens.
#                                                     Set EDGE_CONTAINER in vars.env to match.)
#        Persistence folder     : /Users/<you>/cyberark   on macOS
#                                 /home/cyberark         on Linux
#                                 (must be a writable absolute path on the host)
#        TLS                    : Auto-generated by Edge
#        COMMON_NAME            : host.docker.internal
#        SAN                    : 127.0.0.1,localhost
#   3. Click 'Create Edge and generate script'.
#   4. Copy the entire generated script.
#   5. Save it as setup/edge/install.sh in this demo dir.
#   6. Run:   bash setup/edge/setup.sh
#
# IMPORTANT:
#   - The token inside the script expires in 8 minutes from generation. Run quickly.
#   - install.sh is gitignored (contains the token). DO NOT commit it.
#   - On macOS, replace the script's '/cyberark' bind mount source with '$HOME/cyberark'
#     before saving. CyberArk's script assumes a Linux host.
#
# The structure of the saved file should look roughly like this (your token + URL):
#
#   sudo chown -R 5000:5000 "$HOME/cyberark" && \
#   sudo docker run -d \
#     --name cybr-conjur-edge \
#     -e CONJUR_CLOUD_URL=https://<tenant>.secretsmgr.cyberark.cloud/api \
#     -e EDGE_INITIAL_CREDS='<long-base64-token-from-saas-ui>' \
#     -e COMMON_NAME=host.docker.internal \
#     -e SAN=127.0.0.1,localhost \
#     -p 443:8443 \
#     -p 444:8444 \
#     --mount type=bind,source="$HOME/cyberark",target=/opt/edge/data \
#     --restart unless-stopped \
#     localhost/cyberark/edge:1.8.0
