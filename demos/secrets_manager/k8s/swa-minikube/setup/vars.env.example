# SWA (Secure Workload Access) demo configuration
# Copy to setup/vars.env and adjust. This file is the single config source for the demo.
#   cp setup/vars.env.example setup/vars.env
#
# Tenant credentials (TENANT_ID, TENANT_SUBDOMAIN, CLIENT_ID, CLIENT_SECRET) come from
# demos/tenant_vars.sh (+ optional demos/tenant_vars.local.sh) — not set here.

# ── Privilege Cloud safe + synced account ────────────────────────────────────
# A dedicated safe for this demo. Conjur Sync replicates it to Conjur Cloud.
SAFE_NAME="k8s-swa"

# Conjur variable paths for the synced account (mirror Privilege Cloud structure:
# data/vault/<safe>/<account>/<property>). Used by the workload to fetch a secret.
SM_SECRET_USERNAME_ID="data/vault/k8s-swa/account-ssh-user-1/username"
SM_SECRET_PASSWORD_ID="data/vault/k8s-swa/account-ssh-user-1/password"

# ── Kubernetes namespaces / identities ───────────────────────────────────────
SWA_NAMESPACE="swa-system"        # SWA Server (Deployment) + SWA Agent (DaemonSet)
SWA_AGENT_SA="swa-agent"          # Agent ServiceAccount (k8s_psat node attestation)
SWA_SERVER_SA="swa-server"        # Server ServiceAccount (authenticates to control plane)
SWA_APP_NAMESPACE="swa-demo"      # Workload namespace
SWA_APP_SA="swa-demo-app"         # Workload ServiceAccount (becomes part of the SPIFFE ID)

# ── SWA control plane (Conjur Cloud) ─────────────────────────────────────────
# The SWA Server registers with Conjur Cloud as its control plane.
# Verify the exact base URL for your tenant (see setup/swa/README.md).
SWA_CONTROL_PLANE_URL="https://${TENANT_SUBDOMAIN}.secretsmgr.cyberark.cloud"

# JWT audience the SWA Server projects when authenticating to the control plane.
SWA_CONTROL_PLANE_AUDIENCE="conjur"

# ── SWA trust domain / groups (created via terraform-provider-swa) ────────────
# Trust domain name is arbitrary but must match between control plane and agent.
SWA_TRUST_DOMAIN="${TENANT_SUBDOMAIN}.swa.cyberark.cloud"
SWA_SERVER_GROUP="k8s-workloads"
SWA_NODE_GROUP="k8s-nodegroup"
SWA_CLUSTER_NAME="minikube"       # must match the k8s_psat cluster name in the server group

# Trust domain JWT signing — MUST be RSA for the authn-jwt integration.
# (Elliptic-curve signing is not supported on the JWT authenticator path.)
SWA_TD_JWT_ALG="RS256"
SWA_TD_JWT_KEY_TYPE="RSA_2048"

# ── Workload -> Conjur authenticator (authn-jwt/secureWorkloadAccess) ─────────
SWA_AUTHN_ID="secureWorkloadAccess"
SWA_JWT_AUDIENCE="conjur"         # audience requested via: swa-agent api fetch jwt -a conjur

# Trust-domain JWKS + issuer the authenticator uses to validate JWT-SVIDs.
# Leave blank to let enable_swa_authenticator.sh derive them from OIDC discovery
# against SWA_CONTROL_PLANE_URL (verified working). Override only if discovery is
# blocked. Verified pattern for reference:
#   issuer = https://${TENANT_SUBDOMAIN}.secretsmgr.cyberark.cloud/api/swa/trust-domains/${SWA_TRUST_DOMAIN}
#   jwks   = <issuer>/.well-known/jwks
SWA_TD_JWKS_URI=""
SWA_TD_ISSUER=""

# ── SWA release artifacts (NOT committed — ~195MB) ───────────────────────────
# Directory holding the downloaded release zip from the CyberArk Marketplace:
#   "Secure Workload Access_1.0_*.zip"
SWA_RELEASE_DIR="${HOME}/Downloads"
# Or pin the exact zip path (takes precedence over SWA_RELEASE_DIR glob):
SWA_RELEASE_ZIP=""
