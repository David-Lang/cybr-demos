#!/usr/bin/env bash
# Demo-specific variables for: SWA Ubuntu
# Tenant credentials are sourced from $CYBR_DEMOS_PATH/demos/tenant_vars.sh

# --- Conjur JWT Authenticator ---
export CONJUR_ACCOUNT="${CONJUR_ACCOUNT:-conjur}"
export CONJUR_JWT_SERVICE_ID="${CONJUR_JWT_SERVICE_ID:-swa1}"

# --- SWA Control Plane ---
# Resource names are scoped to LAB_ID when set, preventing Conjur naming conflicts
# across lab instances (the SWA provider does not clean up Conjur resources on destroy).
# Override any of these explicitly to use a different name.
_swa_lab="${LAB_ID:-demo}"
export SWA_RESOURCE_PREFIX="${SWA_RESOURCE_PREFIX:-swa-${_swa_lab}}"
export SWA_TRUST_DOMAIN_NAME="${SWA_TRUST_DOMAIN_NAME:-swa-${_swa_lab}.workloads.local}"
export SWA_NODE_GROUP_NAME="${SWA_NODE_GROUP_NAME:-swa-${_swa_lab}-nodes}"
unset _swa_lab

# --- SWA Runtime ---
export SWA_SERVER_HOST="${SWA_SERVER_HOST:-localhost}"
export SWA_JWT_TTL="${SWA_JWT_TTL:-600}"
export SWA_SOCKET_PATH="${SWA_SOCKET_PATH:-/run/swa-agent/api.sock}"

# --- SWA Mode ---
# "mock": uses local RSA key pair, no SWA binaries needed
# "real": uses actual SWA Server + Agent binaries
export SWA_MODE="${SWA_MODE:-mock}"
export SWA_AGENT_BIN="${SWA_AGENT_BIN:-/opt/swa/bin/swa-agent}"

# --- Mock SWA (used when SWA_MODE=mock) ---
export SWA_MOCK_ISSUER="${SWA_MOCK_ISSUER:-https://mock.swa.local}"
export SWA_DOMAIN="${SWA_DOMAIN:-spiffe://demo.local}"
export SWA_WORKLOAD_ID="${SWA_WORKLOAD_ID:-swa-hello-world}"

# --- Conjur JWT authenticator identity config ---
# Conjur policy path where workload host identities live.
# mock: data/workloads/swa  (static host created by workload_identity.yml)
# real: update after first attestation to match where SWA auto-creates the host
export SWA_IDENTITY_PATH="${SWA_IDENTITY_PATH:-data/workloads/swa}"

# --- Real SWA OIDC Issuer (populated by register_control_plane.sh → swa_registered.env) ---
export SWA_OIDC_ISSUER="${SWA_OIDC_ISSUER:-INPUT_REQUIRED}"

# --- Demo Secret ---
export DEMO_SECRET_ID="${DEMO_SECRET_ID:-data/demo/db_password}"
export DEMO_SECRET_VALUE="${DEMO_SECRET_VALUE:-S3cr3tV@lue!}"
