# inputs.env — "Onboard Azure AKV" activity inputs.
#
# setup.sh sources this file (INPUTS_ENV overrides the path). Tenant/service
# account vars (LAB_ID, TENANT_ID, TENANT_SUBDOMAIN, CLIENT_ID, CLIENT_SECRET)
# come from the environment / demos/tenant_vars.sh via setup_env.sh and are NOT
# repeated here.
#
# When the Idira Vegas app runs this activity (in a Kubernetes Job), it injects
# these values from the AKV "app-set" it just provisioned. For a manual run,
# fill them in and `source setup_env.sh` first.

# ---- Privilege Cloud App Safe -------------------------------------------------
# Safe that holds the rotation-demo account and is synced to the AKV.
SAFE_NAME="${SAFE_NAME:-SET_SAFE_NAME}"
SAFE_DESCRIPTION="${SAFE_DESCRIPTION:-Idira Vegas Secret Stores app safe}"
# Secrets Hub sync service member added to the safe (source-side read access).
SECRETSHUB_MEMBER="${SECRETSHUB_MEMBER:-SecretsHub}"

# ---- Rotation-demo Azure app registration (vaulted as an account) -------------
# The standalone Entra app reg the app created purely to demo Secrets Hub
# rotation of its client secret. Not used to access any resource.
ROTATION_ACCOUNT_NAME="${ROTATION_ACCOUNT_NAME:-akv-rotation-demo-app}"
ROTATION_APP_CLIENT_ID="${ROTATION_APP_CLIENT_ID:-SET_ROTATION_APP_CLIENT_ID}"
ROTATION_APP_OBJECT_ID="${ROTATION_APP_OBJECT_ID:-SET_ROTATION_APP_OBJECT_ID}"
ROTATION_APP_CLIENT_SECRET="${ROTATION_APP_CLIENT_SECRET:-SET_ROTATION_APP_CLIENT_SECRET}"
ROTATION_APP_KEY_ID="${ROTATION_APP_KEY_ID:-}"

# ---- Azure Key Vault (Secrets Hub target store) -------------------------------
AKV_VAULT_NAME="${AKV_VAULT_NAME:-SET_AKV_VAULT_NAME}"
AKV_VAULT_URL="${AKV_VAULT_URL:-https://${AKV_VAULT_NAME}.vault.azure.net}"
AZURE_TENANT_ID="${AZURE_TENANT_ID:-SET_AZURE_TENANT_ID}"          # appClientDirectoryId
AZURE_SUBSCRIPTION_ID="${AZURE_SUBSCRIPTION_ID:-SET_AZURE_SUBSCRIPTION_ID}"
AZURE_SUBSCRIPTION_NAME="${AZURE_SUBSCRIPTION_NAME:-SET_AZURE_SUBSCRIPTION_NAME}"
AZURE_RESOURCE_GROUP="${AZURE_RESOURCE_GROUP:-SET_AZURE_RESOURCE_GROUP}"

# The SEPARATE app registration Secrets Hub uses to reach the AKV via workload
# identity federation (FEDERATED_IDENTITY). NOT the rotation-demo app above and
# NOT a client secret. Provisioned/registered for the tenant's Secrets Hub.
SECRETSHUB_AZURE_APP_CLIENT_ID="${SECRETSHUB_AZURE_APP_CLIENT_ID:-SET_SECRETSHUB_AZURE_APP_CLIENT_ID}"

# ---- Secrets Hub objects ------------------------------------------------------
SECRET_STORE_NAME="${SECRET_STORE_NAME:-${AKV_VAULT_NAME}}"
SECRET_STORE_DESCRIPTION="${SECRET_STORE_DESCRIPTION:-Idira Vegas AKV target}"
SYNC_POLICY_NAME="${SYNC_POLICY_NAME:-${SAFE_NAME}-to-${AKV_VAULT_NAME}}"
SYNC_POLICY_DESCRIPTION="${SYNC_POLICY_DESCRIPTION:-Sync ${SAFE_NAME} to AKV ${AKV_VAULT_NAME}}"

# Optional: skip the sync-policy step (store-onboarding only) for debugging.
CREATE_SYNC_POLICY="${CREATE_SYNC_POLICY:-1}"
