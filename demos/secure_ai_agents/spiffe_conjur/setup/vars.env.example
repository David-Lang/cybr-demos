#------------------------------------------------------------------------------
# Demo Identity. LAB_ID is normally defined in demos/tenant_vars.sh; the default
# here lets a fresh clone source this file under `set -u` without erroring.
USECASE_ID="${LAB_ID:-default}-spiffe-conjur"
#------------------------------------------------------------------------------
# Local Kubernetes (minikube) — runs the SPIRE control plane and the demo workloads
MINIKUBE_PROFILE="$USECASE_ID"
MINIKUBE_K8S_VERSION="v1.31.0"
MINIKUBE_CPUS="4"
MINIKUBE_MEMORY="6144"
MINIKUBE_DRIVER="docker"
#------------------------------------------------------------------------------
# SPIRE — open-source workload identity (https://spiffe.io/)
SPIRE_HELM_REPO_NAME="spiffe"
SPIRE_HELM_REPO_URL="https://spiffe.github.io/helm-charts-hardened/"
SPIRE_CRDS_VERSION="0.5.0"
SPIRE_VERSION="0.28.4"
SPIRE_NAMESPACE="spire-mgmt"
TRUST_DOMAIN="$USECASE_ID.local"
SPIRE_TOOLS_IMAGE="spire-tools:1.13.2"
#------------------------------------------------------------------------------
# Workload identities (must match Conjur Cloud host annotations exactly)
WORKLOADS_NAMESPACE="workloads"
VULNERABLE_NAMESPACE="vulnerable-agents"
ATTESTED_AGENT_SA="agent"
ATTESTED_AGENT_NAME="attested-agent"
SPIFFE_HOST_ID="spiffe://$TRUST_DOMAIN/ns/$WORKLOADS_NAMESPACE/sa/$ATTESTED_AGENT_SA/app/$ATTESTED_AGENT_NAME"
#------------------------------------------------------------------------------
# Conjur Cloud authn-jwt configuration
CONJUR_AUTHN_SERVICE_ID="spiffe-auth"
CONJUR_AUTHN_BRANCH="conjur/authn-jwt/$CONJUR_AUTHN_SERVICE_ID"
CONJUR_HOSTS_BRANCH="data/spiffe-apps"
CONJUR_SECRET_BRANCH="data/spiffe-secrets"
CONJUR_SECRET_VARIABLE="$CONJUR_SECRET_BRANCH/openai-api-key"
DEMO_SECRET_VALUE="sk-VAULTED-rotates-in-conjur-7q9zABCDEFGHIJK"
#------------------------------------------------------------------------------
# Cloudflared — exposes SPIRE OIDC discovery provider to Conjur Cloud
# Leave blank for a fresh quick tunnel each session (URL changes every run).
# Set to a pre-created named tunnel for a stable URL across demos:
#   cloudflared tunnel create $USECASE_ID-jwks
CLOUDFLARED_TUNNEL_NAME=""
CLOUDFLARED_TUNNEL_HOSTNAME=""
CLOUDFLARED_LOCAL_PORT="8080"
#------------------------------------------------------------------------------
